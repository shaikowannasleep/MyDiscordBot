# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_optional_for_fast_slash_registration

# Telegram Bot Configuration (Get from @BotFather in 30s)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Your personal Telegram Chat ID to mirror all Discord alarms straight to your phone
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 24/7 Hosting & Keep-Alive Server
PORT=3000

# Database & Environment
DATABASE_PATH=./data/alarm_bot.sqlite
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
